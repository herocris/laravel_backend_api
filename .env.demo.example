APP_NAME="GraphMapApp Demo"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8016
APP_TIMEZONE=UTC
AUTH_GUARD=api

DB_URL=
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/portfolio-demo.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict
CACHE_STORE=database
CACHE_PREFIX=portfolio_demo_
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
LOG_CHANNEL=single
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8016
